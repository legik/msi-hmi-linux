{
  "screen": "stats",
  "brightness": 50,
  "stats_interval": 3,
  "theme": "monokai",
  "clock_24h": true,
  "hwmon_mode": "multi",
  "hwmon_sensors": ["fps", "cpu_load", "cpu_temp", "cpu_clock", "cpu_power", "gpu_load",
                    "gpu_temp", "gpu_clock", "gpu_power", "ram_used", "download", "upload"],
  "fan_map": {"cpu_fan": "fan1", "pump": "fan2", "sys_fan": "fan4"},
  "vrm_temp_label": "Thermistor 15",
  "game_screen": "layout:gaming",
  "light_on_start": 92,
  "light_colors": {"82": "0ABAB5"},
  "touch_actions": {"2": "user:steam", "3": "user:firefox"},
  "proxy": null
}
