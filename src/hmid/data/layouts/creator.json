{
  "comment": "Creator dashboard: YouTube, Twitch (live status, viewers, next stream), Bluesky, Mastodon and GitHub. Replace every YOUR_... in the urls and headers; leave out a platform by deleting its source (its widgets then show -). See docs/LAYOUTS.md#creator for where to get the ids and keys.",
  "refresh": 30,
  "sources": {
    "yt":     {"type": "http", "every": 900,
               "url": "https://www.googleapis.com/youtube/v3/channels?part=snippet,statistics&id=YOUR_CHANNEL_ID&key=YOUR_API_KEY"},
    "upload": {"type": "http", "every": 900,
               "url": "https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&maxResults=1&playlistId=YOUR_UPLOADS_PLAYLIST_ID&key=YOUR_API_KEY"},
    "tw":     {"type": "http", "every": 600,
               "url": "https://api.twitch.tv/helix/channels/followers?broadcaster_id=YOUR_TWITCH_USER_ID",
               "headers": {"Client-Id": "YOUR_CLIENT_ID", "Authorization": "Bearer YOUR_APP_TOKEN"}},
    "live":   {"type": "http", "every": 60,
               "url": "https://api.twitch.tv/helix/streams?user_login=YOUR_TWITCH_LOGIN",
               "headers": {"Client-Id": "YOUR_CLIENT_ID", "Authorization": "Bearer YOUR_APP_TOKEN"}},
    "sched":  {"type": "http", "every": 1800,
               "url": "https://api.twitch.tv/helix/schedule?broadcaster_id=YOUR_TWITCH_USER_ID&first=1",
               "headers": {"Client-Id": "YOUR_CLIENT_ID", "Authorization": "Bearer YOUR_APP_TOKEN"}},
    "bsky":   {"type": "http", "every": 600,
               "url": "https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?actor=YOUR_HANDLE.bsky.social"},
    "post":   {"type": "http", "every": 300,
               "url": "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=YOUR_HANDLE.bsky.social&limit=1&filter=posts_no_replies"},
    "masto":  {"type": "http", "every": 600,
               "url": "https://mastodon.social/api/v1/accounts/lookup?acct=YOUR_NAME"},
    "gh":     {"type": "http", "every": 1800,
               "url": "https://api.github.com/users/YOUR_GITHUB_NAME"}
  },
  "widgets": [
    {"type": "text", "x": 24, "y": 22, "text": "CREATOR", "size": 22, "color": "header", "spacing": 3},
    {"type": "text", "x": 456, "y": 18, "text": "{time:%H:%M}", "size": 26, "align": "right"},
    {"type": "divider", "y": 62},

    {"type": "card", "x": 16, "y": 76, "w": 448, "h": 232},
    {"type": "text", "x": 34, "y": 92, "text": "YOUTUBE", "color": "header"},
    {"type": "text", "x": 446, "y": 95, "text": "{yt.items.0.snippet.title}", "size": 17, "align": "right", "bold": false, "color": "secondary", "max_width": 260},
    {"type": "text", "x": 34, "y": 120, "text": "{yt.items.0.statistics.subscriberCount:,.0f}", "size": 60, "color": "value", "suffix": "subscribers", "suffix_size": 20, "suffix_gap": 10},
    {"type": "text", "x": 34, "y": 196, "text": "{yt.items.0.statistics.viewCount|compact} views  ·  {yt.items.0.statistics.videoCount:,.0f} videos", "size": 18, "bold": false, "color": "secondary"},
    {"type": "text", "x": 34, "y": 226, "text": "▶ {upload.items.0.snippet.title}", "size": 18, "max_width": 300, "when": "upload.items.0"},
    {"type": "text", "x": 446, "y": 227, "text": "{upload.items.0.snippet.publishedAt|ago}", "size": 17, "align": "right", "bold": false, "color": "secondary", "when": "upload.items.0"},
    {"type": "graph", "x": 16, "y": 262, "w": 448, "h": 46, "value": "yt.items.0.statistics.subscriberCount", "seconds": 86400, "min": "yt.items.0.statistics.subscriberCount|mul(0.98)", "clip": true},
    {"type": "card", "x": 16, "y": 76, "w": 448, "h": 232, "fill": false},

    {"type": "card", "x": 16, "y": 318, "w": 448, "h": 168},
    {"type": "text", "x": 34, "y": 334, "text": "TWITCH", "color": "header"},
    {"type": "text", "x": 446, "y": 334, "text": "● LIVE", "size": 20, "align": "right", "color": "crit", "when": "live.data.0"},
    {"type": "text", "x": 446, "y": 337, "text": "offline", "size": 17, "align": "right", "bold": false, "color": "secondary", "when": "!live.data.0"},
    {"type": "text", "x": 34, "y": 362, "text": "{tw.total:,.0f}", "size": 48, "color": "value", "suffix": "followers", "suffix_size": 20, "suffix_gap": 10},
    {"type": "text", "x": 34, "y": 424, "text": "{live.data.0.viewer_count:,.0f} watching  ·  {live.data.0.game_name}", "size": 20, "max_width": 412, "when": "live.data.0"},
    {"type": "text", "x": 34, "y": 454, "text": "{live.data.0.title}", "size": 17, "bold": false, "color": "secondary", "max_width": 412, "when": "live.data.0"},
    {"type": "text", "x": 34, "y": 424, "text": "Next: {sched.data.segments.0.title}", "size": 20, "max_width": 412, "when": "!live.data.0"},
    {"type": "text", "x": 34, "y": 454, "text": "{sched.data.segments.0.start_time|date}, {sched.data.segments.0.start_time|time}  ·  {sched.data.segments.0.start_time|ago}", "size": 17, "bold": false, "color": "secondary", "when": "!live.data.0"},

    {"type": "card", "x": 16, "y": 496, "w": 142, "h": 130},
    {"type": "text", "x": 32, "y": 510, "text": "BLUESKY", "size": 15, "color": "header"},
    {"type": "text", "x": 32, "y": 542, "text": "{bsky.followersCount|compact}", "size": 40, "color": "value"},
    {"type": "text", "x": 32, "y": 598, "text": "followers", "size": 15, "bold": false, "color": "secondary"},
    {"type": "card", "x": 169, "y": 496, "w": 142, "h": 130},
    {"type": "text", "x": 185, "y": 510, "text": "MASTODON", "size": 15, "color": "header"},
    {"type": "text", "x": 185, "y": 542, "text": "{masto.followers_count|compact}", "size": 40, "color": "value"},
    {"type": "text", "x": 185, "y": 598, "text": "followers", "size": 15, "bold": false, "color": "secondary"},
    {"type": "card", "x": 322, "y": 496, "w": 142, "h": 130},
    {"type": "text", "x": 338, "y": 510, "text": "GITHUB", "size": 15, "color": "header"},
    {"type": "text", "x": 338, "y": 542, "text": "{gh.followers|compact}", "size": 40, "color": "value"},
    {"type": "text", "x": 338, "y": 598, "text": "followers", "size": 15, "bold": false, "color": "secondary"},

    {"type": "card", "x": 16, "y": 636, "w": 448, "h": 144},
    {"type": "text", "x": 34, "y": 652, "text": "LATEST POST", "color": "header"},
    {"type": "text", "x": 446, "y": 655, "text": "{post.feed.0.post.indexedAt|ago}", "size": 17, "align": "right", "bold": false, "color": "secondary"},
    {"type": "text", "x": 34, "y": 690, "text": "{post.feed.0.post.record.text|line(0)}", "size": 20, "bold": false, "max_width": 412},
    {"type": "text", "x": 34, "y": 738, "text": "♥ {post.feed.0.post.likeCount:,.0f}     ⟲ {post.feed.0.post.repostCount:,.0f}     ↩ {post.feed.0.post.replyCount:,.0f}", "size": 20, "color": "secondary"}
  ]
}
