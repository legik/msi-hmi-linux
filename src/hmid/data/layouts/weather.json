{
  "comment": "Weather from MET Norway (api.met.no, no API key), updated hourly; screen redrawn once a minute. Moscow; to change the city edit lat/lon in both URLs (max 4 decimals) and the city name below. Feels-like is calculated; H/L are for the rest of today; the graph shows the next 24 hours.",
  "refresh": 60,
  "sources": {
    "met": {"type": "http", "every": 3600, "timeout": 20, "url": "https://api.met.no/weatherapi/locationforecast/2.0/complete?lat=55.7558&lon=37.6173"},
    "sun": {"type": "http", "every": 3600, "url": "https://api.met.no/weatherapi/sunrise/3.0/sun?lat=55.7558&lon=37.6173"}
  },
  "widgets": [
    {"type": "text", "x": 24, "y": 22, "text": "Moscow", "size": 22, "color": "header", "transform": "upper", "spacing": 2},
    {"type": "text", "x": 456, "y": 18, "text": "{time:%H:%M}", "size": 26, "align": "right"},
    {"type": "divider", "y": 62},
    {"type": "card", "x": 16, "y": 76, "w": 448, "h": 340},
    {"type": "icon", "x": 36, "y": 100, "size": 104, "icon": "{met.properties.timeseries.0.data.next_1_hours.summary.symbol_code|met_icon}"},
    {"type": "text", "x": 160, "y": 114, "text": "{met.properties.timeseries.0.data.instant.details.air_temperature:.0f}°C", "size": 72, "color": "value"},
    {"type": "text", "x": 40, "y": 226, "size": 16, "bold": false, "color": "secondary", "max_width": 400, "text": "{met.properties.timeseries.0.data.next_1_hours.summary.symbol_code|met_text} · FEELS {met.properties.timeseries.0.data.instant.details|feels:.0f}°C · H:{met.properties.timeseries|today|pluck(data.instant.details.air_temperature)|max:.0f}° L:{met.properties.timeseries|today|pluck(data.instant.details.air_temperature)|min:.0f}°"},
    {"type": "graph", "x": 16, "y": 262, "w": 448, "h": 154, "clip": true, "series": "met.properties.timeseries|first(24)|pluck(data.instant.details.air_temperature)"},
    {"type": "card", "x": 16, "y": 76, "w": 448, "h": 340, "fill": false, "comment": "border again, on top of the graph"},
    {"type": "card", "x": 16, "y": 428, "w": 219, "h": 171},
    {"type": "text", "x": 32, "y": 440, "text": "HUMIDITY", "size": 15, "color": "header"},
    {"type": "text", "x": 32, "y": 500, "text": "{met.properties.timeseries.0.data.instant.details.relative_humidity:.0f}", "size": 40, "color": "value", "suffix": "%"},
    {"type": "bar", "x": 32, "y": 579, "w": 187, "value": "met.properties.timeseries.0.data.instant.details.relative_humidity", "max": 100, "rule": "none"},
    {"type": "card", "x": 245, "y": 428, "w": 219, "h": 171},
    {"type": "text", "x": 261, "y": 440, "text": "WIND", "size": 15, "color": "header"},
    {"type": "text", "x": 448, "y": 442, "text": "{met.properties.timeseries.0.data.instant.details.wind_from_direction|compass}", "size": 13, "align": "right", "bold": false, "color": "secondary"},
    {"type": "text", "x": 261, "y": 500, "text": "{met.properties.timeseries.0.data.instant.details.wind_speed|mul(3.6):.0f}", "size": 40, "color": "value", "suffix": "km/h"},
    {"type": "bar", "x": 261, "y": 579, "w": 187, "value": "met.properties.timeseries.0.data.instant.details.wind_speed|mul(3.6)", "max": 60, "rule": "none"},
    {"type": "card", "x": 16, "y": 609, "w": 219, "h": 171},
    {"type": "text", "x": 32, "y": 621, "text": "UV INDEX", "size": 15, "color": "header"},
    {"type": "text", "x": 219, "y": 623, "text": "RAIN {met.properties.timeseries.0.data.next_1_hours.details.precipitation_amount:.1f} mm", "size": 13, "align": "right", "bold": false, "color": "secondary"},
    {"type": "text", "x": 32, "y": 681, "text": "{met.properties.timeseries.0.data.instant.details.ultraviolet_index_clear_sky:.0f}", "size": 40, "color": "value", "suffix": "{met.properties.timeseries.0.data.instant.details.ultraviolet_index_clear_sky|uv_level}", "value": "met.properties.timeseries.0.data.instant.details.ultraviolet_index_clear_sky", "warn": 3, "crit": 6},
    {"type": "bar", "x": 32, "y": 760, "w": 187, "value": "met.properties.timeseries.0.data.instant.details.ultraviolet_index_clear_sky", "max": 11, "warn": 3, "crit": 6},
    {"type": "card", "x": 245, "y": 609, "w": 219, "h": 171},
    {"type": "text", "x": 261, "y": 621, "text": "PRESSURE", "size": 15, "color": "header"},
    {"type": "text", "x": 448, "y": 623, "text": "SUNSET {sun.properties.sunset.time|time}", "size": 13, "align": "right", "bold": false, "color": "secondary"},
    {"type": "text", "x": 261, "y": 681, "text": "{met.properties.timeseries.0.data.instant.details.air_pressure_at_sea_level:.0f}", "size": 40, "color": "value", "suffix": "hPa"},
    {"type": "bar", "x": 261, "y": 760, "w": 187, "value": "met.properties.timeseries.0.data.instant.details.air_pressure_at_sea_level", "min": 980, "max": 1040, "rule": "none"}
  ]
}
